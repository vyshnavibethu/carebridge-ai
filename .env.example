# CareBridge AI Environment Configuration

# Hospital FastAPI Endpoint (Local default or deployed HTTPS URL)
HOSPITAL_API_URL=http://127.0.0.1:8000

# Optional CORS Frontend URL for FastAPI
FRONTEND_URL=*

# Server Port (for production FastAPI uvicorn deployment)
PORT=8000

# Optional Gemini API Key for enhanced LLM capabilities
GEMINI_API_KEY=your_gemini_api_key_here
